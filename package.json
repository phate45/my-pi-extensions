{
  "name": "pi-customizations",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "pi": {
    "extensions": [
      "./extensions/infra/*.ts",
      "./extensions/cc-like/index.ts",
      "./extensions/my-stuff/*.ts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "dependencies": {
    "diff": "^8.0.2",
    "minimatch": "^10.2.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "typebox": "1.3.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "overrides": {
    "ws": "8.21.0",
    "brace-expansion": "5.0.6",
    "protobufjs": "7.6.4"
  }
}
