  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "overrides": {
    "ws": "8.21.0",
    "brace-expansion": "5.0.6",
    "protobufjs": "7.6.4"
